{
  "name": "@tracer-sh/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./src/trpc/router.ts"
    },
    "./mobile": {
      "types": "./src/mobile.ts",
      "import": "./src/mobile.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "tsx --test $(find src -name '*.test.ts')",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.67",
    "@ai-sdk/google": "^4.0.84",
    "@ai-sdk/google-vertex": "^5.0.97",
    "@ai-sdk/mcp": "^2.0.61",
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "^0.4.2",
    "@napi-rs/keyring": "^2.1.0",
    "@tracer-sh/shared": "workspace:*",
    "@trpc/server": "^11.19.0",
    "ai": "^7.0.120",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.10",
    "qrcode": "^1.5.4",
    "superjson": "^2.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/qrcode": "^1.5.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
